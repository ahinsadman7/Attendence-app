<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Department"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerDepartment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etSeriesNo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Series No. (e.g. 24)"
            android:inputType="number" />

        <EditText
            android:id="@+id/etCourseCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Course Code" />

        <EditText
            android:id="@+id/etFirstRoll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="First Roll (e.g. 1)"
            android:inputType="number" />

        <EditText
            android:id="@+id/etLastRoll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Last Roll (e.g. 60)"
            android:inputType="number" />

        <EditText
            android:id="@+id/etPermanentAbsent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Permanent Absent Rolls (comma separated)" />

        <EditText
            android:id="@+id/etExtraRolls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Extra Rolls (comma separated)" />

    </LinearLayout>
</ScrollView>
